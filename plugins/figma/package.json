{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-figma",
  "version": "2.2.5",
  "description": "Figma MCP integration and official Figma skills for OpenCode",
  "type": "module",
  "main": "./server/main.ts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "plugins/figma"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./server/main.ts",
    "./server": "./server/main.ts"
  },
  "files": [
    "ocplugin.json",
    "server",
    "skills",
    "skills-source.json"
  ],
  "scripts": {
    "typecheck": "bun check --no-script",
    "typecheck:tsc": "tsc --noEmit",
    "sync:skills": "bun run script/sync-skills.ts"
  },
  "dependencies": {
    "gray-matter": "4.0.3"
  },
  "peerDependencies": {
    "@opencode/plugin": "^2.0.27 || ^0.0.0-dev"
  },
  "devDependencies": {
    "@tsconfig/bun": "1.0.9",
    "@types/bun": "1.4.3",
    "@typescript/native": "npm:typescript@7.1.0-beta"
  }
}
