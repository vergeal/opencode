{
  "$schema": "https://json.schemastore.org/package.json",
  "name": "@opencode/plugin-chrome",
  "version": "2.2.0",
  "description": "OpenCode's Chrome extension bridge: drive the user's own Chrome tabs over a local WebSocket",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/anomalyco/opencode.git",
    "directory": "packages/plugin-chrome"
  },
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./rpc": "./src/rpc.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json && bun run script/build.ts",
    "typecheck": "bun check --no-script -p tsconfig.test.json",
    "typecheck:tsc": "tsc --noEmit -p tsconfig.test.json",
    "test": "bun test"
  },
  "dependencies": {
    "@opencode/plugin": "workspace:*",
    "@opencode/schema": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@tsconfig/bun": "catalog:",
    "@types/bun": "catalog:",
    "@typescript/native": "catalog:",
    "typescript": "catalog:"
  }
}
